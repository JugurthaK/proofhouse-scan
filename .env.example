# GitHub classic PAT with `repo` + `workflow` scopes.
# Used to: dispatch the scan workflow, download artifacts, read target repo
# files, push fix branches, create forks and pull requests.
GITHUB_TOKEN=

# The GitHub repo (owner/name) that hosts .github/workflows/scan.yml — i.e.
# this repository, once pushed to GitHub.
PROOFHOUSE_SCAN_REPO=

# LLM used for qualification and remediation.
# LLM_PROVIDER: anthropic | openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=            # only if LLM_PROVIDER=openai

# Optional overrides
# PROOFHOUSE_SCAN_DB_PATH=~/.proofhouse-scan/proofhouse-scan.db
# PORT=8790
# HOST=127.0.0.1                 # set 0.0.0.0 when hosting

# Hosted-instance auth (all optional; nothing set = open, for local dev).
#
# Web UI sign-in with GitHub: create an OAuth App (GitHub → Settings →
# Developer settings → OAuth Apps) with callback URL
# https://<your-host>/api/auth/github/callback. Requires an allowlist —
# the server refuses to start with OAuth enabled but no allowed users/orgs.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# PROOFHOUSE_SCAN_ALLOWED_USERS=alice,bob    # GitHub logins
# PROOFHOUSE_SCAN_ALLOWED_ORGS=acme          # active org members (requests read:org)
#
# PROOFHOUSE_SCAN_API_TOKEN=             # Bearer token for scripts calling /api/*
# PROOFHOUSE_SCAN_INGEST_TOKEN=          # required by POST /api/ingest (the GitHub Action)
