# GitHub classic PAT with `repo` + `workflow` scopes — needed only for GitHub
# repos. Used to: dispatch the scan workflow, download artifacts, read target
# repo files, push fix branches, create forks and pull requests.
GITHUB_TOKEN=

# The GitHub repo (owner/name) that hosts .github/workflows/scan.yml — i.e.
# this repository, once pushed to GitHub. Needed only to dispatch GitHub scans.
PROOFHOUSE_SCAN_REPO=

# GitLab tokens — needed only for GitLab repos. Personal/project access tokens
# with the `api` scope, held by a user with at least the Developer role on the
# target projects (fix MRs push a branch; there is no fork fallback).
# Used to: read target repo files, push fix branches, open merge requests.
# GITLAB_TOKEN=glpat-…                   # shorthand for gitlab.com
# GITLAB_TOKENS=gitlab.com=glpat-…,git.corp.io=glpat-…
#   one host=token per instance; use a URL key for http or a port:
#   http://localhost:8929=glpat-…
#
# For central dispatch (`proofhouse-scan scan gitlab.com/group/project`): the
# project on each instance that holds this repo's .gitlab-ci.yml. Scans of a
# target run on its own instance. The token's user needs the Developer role
# on the scan project to create pipelines.
# GITLAB_SCAN_PROJECTS=gitlab.com=you/proofhouse-scan,git.corp.io=security/proofhouse-scan

# LLM used for qualification and remediation.
# LLM_PROVIDER: anthropic | openai | ollama | openai-compatible
# LLM_MODEL is required for every provider except anthropic.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=            # only if LLM_PROVIDER=openai
#
# Open models via Ollama (no key needed):
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3-coder:30b
# LLM_BASE_URL=http://127.0.0.1:11434    # default; http://host.docker.internal:11434 from Docker
# LLM_NUM_CTX=32768                      # context window (default); remediation sends + returns whole files
#
# Any OpenAI-compatible API (LM Studio, vLLM, llama.cpp, OpenRouter, Groq, ...):
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_MODEL=                             # model id as the server names it
# LLM_API_KEY=                           # if the server requires one (also sent to Ollama when set)

# Optional overrides
# PROOFHOUSE_SCAN_DB_PATH=~/.proofhouse-scan/proofhouse-scan.db
# PORT=8790
# HOST=127.0.0.1                 # set 0.0.0.0 when hosting

# Hosted-instance auth (all optional; nothing set = open, for local dev).
#
# Web UI sign-in with GitHub: create an OAuth App (GitHub → Settings →
# Developer settings → OAuth Apps) with callback URL
# https://<your-host>/api/auth/github/callback. Requires an allowlist —
# the server refuses to start with OAuth enabled but no allowed users/orgs.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# PROOFHOUSE_SCAN_ALLOWED_USERS=alice,bob    # GitHub logins
# PROOFHOUSE_SCAN_ALLOWED_ORGS=acme          # active org members (requests read:org)
#
# PROOFHOUSE_SCAN_API_TOKEN=             # Bearer token for scripts calling /api/*
# PROOFHOUSE_SCAN_INGEST_TOKEN=          # required by POST /api/ingest (the GitHub Action)
#
# PROOFHOUSE_SCAN_LANDING=true           # show landing.html at "/" to signed-out visitors
